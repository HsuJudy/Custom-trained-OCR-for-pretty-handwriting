// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  projects Project[]
  labels   Label[]

  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  images      Image[]
  entries     JournalEntry[]

  @@map("projects")
}

model Image {
  id        String   @id @default(cuid())
  filename  String
  originalName String
  fileSize  Int
  mimeType  String
  width     Int?
  height    Int?
  uploadedAt DateTime @default(now())
  status    ImageStatus @default(UPLOADED)

  // Relations
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  labels    Label[]
  entries   JournalEntry[]

  @@map("images")
}

model Label {
  id        String   @id @default(cuid())
  text      String
  x         Float
  y         Float
  width     Float
  height    Float
  confidence Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  imageId   String
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("labels")
}

model JournalEntry {
  id          String   @id @default(cuid())
  entryId     String   @unique // Original entry ID from OCR
  date        DateTime?
  textContent String
  enhancedText String?
  pageNumber  Int?
  confidence  Float?
  colorCode   String?  // Hex color code for stickers
  sentiment   Float?
  
  // Analysis data
  themes      String[] // Array of theme strings
  characters  String[] // Array of character names
  locations   String[] // Array of location names
  narrativeThreads String[] // Array of narrative thread names
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  imageId     String
  image       Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("journal_entries")
}

model ColorSticker {
  id        String   @id @default(cuid())
  color     String   // Color name (red, blue, green, etc.)
  colorHex  String   // Hex color code
  x         Float
  y         Float
  width     Float
  height    Float
  confidence Float
  createdAt DateTime @default(now())

  // Relations
  imageId   String
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@map("color_stickers")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum ImageStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  ERROR
}
